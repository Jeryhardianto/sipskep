# Template .env produksi. File asli (.env.prod) HANYA ada di vm-gpu,
# chmod 600, tidak pernah di-rsync dan tidak pernah di-commit.

# Trailing slash wajib — view menyambung "assets/..." langsung ke belakangnya.
BASEURL=https://sipskep.blataktech.com/

DB_USER=sipskep
DB_PASS=
DB_NAME=sipskep

# Hanya untuk backup/maintenance, aplikasi tidak memakainya.
DB_ROOT_PASS=

# Kredensial SMTP Gmail untuk email verifikasi pendaftaran.
# Kosong = kirim_email() balas "Gagal: MAIL_PASSWORD belum diset", tidak crash.
MAIL_USERNAME=
MAIL_PASSWORD=
